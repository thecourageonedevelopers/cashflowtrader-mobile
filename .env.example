# Copy to .env and adjust for your environment.
# Gateway base URL — same host the web frontend's VITE_API_BASE_URL points to.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth Client IDs (native/Android + web-type, per Google Cloud Console).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Must match the gateway's RESPONSE_ENCRYPTION_KEY exactly — see ResponseEncryptionFilter
# (backend) / decryptResponseData (src/utils/responseCrypto.js). Any string; both sides SHA-256
# it into the real key. Same value as web's VITE_RESPONSE_ENCRYPTION_KEY for the same environment.
EXPO_PUBLIC_RESPONSE_ENCRYPTION_KEY=
